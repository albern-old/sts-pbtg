{
  "expo": {
    "name": "Langkah.",
    "slug": "kinetic-pulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Akses sensor lokasi GPS diperlukan untuk menghitung jarak tempuh dan kecepatan aktivitas olahraga Anda."
      }
    },
    "android": {
      "package": "com.kineticpulse.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withSafeGradleProjectName",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F8F9FF"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Akses sensor lokasi GPS diperlukan untuk menghitung jarak tempuh dan kecepatan aktivitas olahraga Anda."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a7d37b57-bd9b-4bbd-be44-be46c3df18ab"
      }
    },
    "owner": "pointerenjoyers-team"
  }
}
